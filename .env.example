# Server-side only. Configure these in Vercel Project Settings > Environment Variables.
# Never add a public/frontend prefix or put the service-role key in dist/.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional local HTTP port. Local development can use its own durable file store
# when Supabase is not configured; Vercel production must require Supabase.
PORT=3000
